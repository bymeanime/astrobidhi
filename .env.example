# AstroBidhi Environment Variables
# Copy this file to .env and fill in your API keys

# ============ Database ============
# Option 1: Turso cloud database (RECOMMENDED for production)
# Sign up: https://turso.tech → Create database → Get URL and auth token
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.so
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# Option 2: Local SQLite file (auto-created if no Turso is configured)
# The app will automatically create a local SQLite database if no Turso URL is set.
# For Railway, mount a persistent volume at /data to persist across deploys.
# DATABASE_URL=file:/data/astrobidhi.db

# NOTE: If neither TURSO_DATABASE_URL nor DATABASE_URL is set, the app
# auto-creates a local SQLite database. Data persists on disk but NOT across
# Railway deploys unless you mount a volume at /data.

# ============ AI Provider API Keys ============
# z-ai-sdk is always available as fallback (no key needed)
# At least one provider key is recommended for faster responses

# OpenRouter API (FREE - 23 free models including Gemma 4 31B, Nemotron 120B)
# Sign up: https://openrouter.ai/ → Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini API (Google AI Studio - free tier: 15 RPM, 1M tokens/min)
# Sign up: https://aistudio.google.com/ → Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (free tier: 14,400 requests/day, extremely fast Llama 3.3 70B)
# Sign up: https://console.groq.com/ → Keys: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# xAI Grok API (free tier available)
# Sign up: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# ============ Admin Authentication ============
# Password for /admin dashboard access (default: astrobidhi2024)
ADMIN_PASSWORD=astrobidhi2024
# Session secret for admin cookies (change in production!)
# Used for BOTH admin session cookies AND Whop user session cookies (HMAC signing)
SESSION_SECRET=astrobidhi-session-secret-change-in-production

# ============ Python ============
# Path to Python binary with vedicastro/flatlib/swisseph installed
# Defaults to 'python3' if not set
# PYTHON_BIN=/path/to/python3

# ============================================================
# ============ Whop.com Integration (PRIVATE) ============
# ============================================================
# AstroBidhi uses Whop as a PRIVATE payment/membership system.
# Users buy your Whop product, then log into AstroBidhi via OAuth to
# unlock premium features. This is NOT a Whop App Store listing —
# no review or approval is required.
#
# Full step-by-step setup guide: see SETUP_WHOP.md in the repo root.
#
# Quick summary:
#   1. Verify your Whop company email at https://whop.com
#   2. Enable Developer Mode at https://whop.com/dashboard/developer
#   3. Create an OAuth app at https://whop.com/dashboard/developer/apps
#      - Set the Redirect URI to your deployment's /api/auth/callback/whop
#      - Copy the Client ID (= WHOP_APP_ID) and Client Secret (= WHOP_CLIENT_SECRET)
#   4. Create a server-side API key in the same dashboard (= WHOP_API_KEY)
#   5. Create a Product at https://whop.com/dashboard/products
#      - Set the price, free trial (e.g., 7 days), and any promo codes
#      - Copy the Product ID from the URL (looks like prod_xxxxxxx) → WHOP_PRODUCT_ID
#   6. (Optional) Set WHOP_CHECKOUT_URL to your product's checkout link
#      for the "Buy Now" button. If omitted, we auto-build one from the product ID.

# Whop OAuth App ID (client_id from your developer dashboard)
WHOP_APP_ID=

# Whop OAuth Client Secret (from your developer dashboard — keep secret!)
WHOP_CLIENT_SECRET=

# Whop server-side API key (used for access checks & membership lists)
WHOP_API_KEY=

# Whop Company ID (your business ID on Whop — fallback if no product ID set)
# Find it at https://whop.com/dashboard/settings — looks like cmp_xxxxxxx
WHOP_COMPANY_ID=

# Whop Product ID (the specific product to check access for — REQUIRED)
# Find it in the URL of your product page — looks like prod_xxxxxxx
WHOP_PRODUCT_ID=

# Whop Experience ID (optional — if you're using experiences instead of products)
# Leave empty if you only use products.
WHOP_EXPERIENCE_ID=

# Whop OAuth Redirect URI — MUST match what you entered in the OAuth app settings.
# Use your actual deployment URL (https://), no trailing slash.
# Examples:
#   Local dev:    http://localhost:3000/api/auth/callback/whop  (Whop may reject http)
#   Production:   https://astrobidhi-production.up.railway.app/api/auth/callback/whop
WHOP_REDIRECT_URI=https://your-deployment-url.example.com/api/auth/callback/whop

# Whop Checkout URL (optional but recommended)
# Direct checkout link for your product. If you set this, the "Buy Now" button
# on your site sends users straight to checkout without going through OAuth first.
# Find it on your product page → "Share" → "Checkout link", or set it to:
#   https://whop.com/checkout/{PRODUCT_ID}
WHOP_CHECKOUT_URL=

# ── Tier-specific Whop products (optional) ──
# If you want to offer multiple subscription tiers (monthly/yearly/lifetime),
# create separate products in Whop for each and set their IDs here.
# When ALL three are set, the premium dialog shows three tier buttons.
# When NONE are set, the dialog falls back to the default WHOP_PRODUCT_ID button.
WHOP_PRODUCT_ID_MONTHLY=
WHOP_PRODUCT_ID_YEARLY=
WHOP_PRODUCT_ID_LIFETIME=

# Tier-specific checkout URLs (optional — auto-generated from product IDs if blank)
WHOP_CHECKOUT_URL_MONTHLY=
WHOP_CHECKOUT_URL_YEARLY=
WHOP_CHECKOUT_URL_LIFETIME=

# ============================================================
# FREE TRIAL / PROMO CODES (Whop Native Features — no code needed):
#   1. Whop supports free trials natively. In your Whop Dashboard → Products →
#      your product → Pricing → enable "Free trial" and set the duration
#      (e.g., 7 days). Users who sign up get full access during the trial.
#   2. Promo codes: Whop Dashboard → Products → your product → "Promo codes".
#      Create codes like "EARLYBIRD50" for 50% off.
#
# ALTERNATIVE: Admin-Granted Access (no Whop needed):
#   Use the /api/admin/access endpoints to grant premium/unlimited access
#   to specific devices without requiring Whop payment. Useful for:
#   - Early adopter rewards, beta testers, manual grants, promo code
#     redemption outside Whop.
# ============================================================

# ============================================================
# ============ Lemon Squeezy Integration ============
# ============================================================
# OPTIONAL alternative / additional payment provider.
# Lemon Squeezy (LS) is a Merchant of Record (MoR) — they handle global
# VAT/sales tax for you, accept PayPal + credit cards natively, and pay
# out via Payoneer (works from Nepal) or bank wire.
#
# You can configure LS ALONGSIDE Whop — the front-end will show "Buy Now"
# buttons for whichever providers are configured. Users who pay via LS get
# premium access via the DeviceAccess table (same mechanism as admin grants),
# so no other code changes are needed.
#
# Full step-by-step setup guide: see SETUP_LEMONSQUEEZY.md in the repo root.
#
# Quick summary:
#   1. Sign up at https://app.lemonsqueezy.com/signup (instant, no review)
#   2. Create a Product with a Variant (e.g., "AstroBidhi Premium Monthly")
#   3. Generate an API key at Settings → API
#   4. Create a Webhook at Settings → Webhooks pointing to:
#        https://YOUR-DEPLOYMENT-URL/api/lemonsqueezy/webhook
#      Copy the signing secret LS gives you.
#   5. Fill in the 5 env vars below.
#   6. Verify in /admin → "Lemon Squeezy" tab.

# LS API key (generate at https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=

# LS Store ID (numeric, found in your store URL or via API)
# Example: if your store URL is https://app.lemonsqueezy.com/stores/12345,
# your store ID is 12345.
LEMONSQUEEZY_STORE_ID=

# LS Variant ID (numeric — the specific subscription variant to sell)
# Find it in the product page URL after creating a product + variant.
LEMONSQUEEZY_VARIANT_ID=

# LS Webhook signing secret (from Settings → Webhooks → your webhook)
# CRITICAL: without this, webhook signature verification fails and LS
# events will be rejected.
LEMONSQUEEZY_WEBHOOK_SECRET=

# OPTIONAL: Manual checkout URL — if set, we use this directly instead of
# generating a fresh checkout session via API. Faster, but no per-user
# customization (email prefill, deviceId tracking).
# Example: https://astrobidhi.lemonsqueezy.com/checkout/buy/variant-12345
LEMONSQUEEZY_CHECKOUT_URL=

# ── Tier-specific LS variants (optional) ──
# Create separate variants in LS for monthly/yearly/lifetime tiers and set
# their IDs here. When set, the premium dialog shows tier buttons.
LEMONSQUEEZY_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_VARIANT_ID_YEARLY=
LEMONSQUEEZY_VARIANT_ID_LIFETIME=

# Tier-specific checkout URLs (optional — auto-generated from variant IDs if blank)
LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=
LEMONSQUEEZY_CHECKOUT_URL_YEARLY=
LEMONSQUEEZY_CHECKOUT_URL_LIFETIME=

# ── Per-analysis one-time purchase variants (optional) ──
# Set a variant ID for each analysis type you want to sell as a one-time purchase.
# When set, the front-end shows a "Buy this analysis" button in the premium dialog.
# Format: LEMONSQUEEZY_VARIANT_<ANALYSIS_TYPE_UPPERCASE>=<variantId>
#
# Example — sell "Cosmic Blueprint" as a $9 one-time purchase:
#   1. In LS, create a "Cosmic Blueprint" variant (one-time payment)
#   2. Get the variant ID (e.g., 67890)
#   3. Set LEMONSQUEEZY_VARIANT_COSMIC_BLUEPRINT=67890
#
# Alternatively, set lsVariantId per analysis in /admin → Catalog (preferred —
# editable at runtime without redeploying).
LEMONSQUEEZY_VARIANT_COSMIC_BLUEPRINT=
LEMONSQUEEZY_VARIANT_SHADOW_INTEGRATION=
LEMONSQUEEZY_VARIANT_SWOT_5YEAR=
# ... add more as needed

# Your deployment URL — used to build the redirect URL after checkout
# and to tell you what URL to register in LS webhook settings.
# Example: https://astrobidhi-production.up.railway.app
NEXT_PUBLIC_URL=https://your-deployment-url.example.com
