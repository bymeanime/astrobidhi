# AstroBidhi Environment Variables
# Copy this file to .env and fill in your API keys

# Database
DATABASE_URL=file:./db/custom.db

# AI Provider API Keys — z-ai-sdk is always available as fallback (no key needed)
# At least one provider key is recommended for faster responses

# OpenRouter API (FREE - 23 free models including Gemma 4 31B, Nemotron 120B)
# Sign up: https://openrouter.ai/ → Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini API (Google AI Studio - free tier: 15 RPM, 1M tokens/min)
# Sign up: https://aistudio.google.com/ → Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (free tier: 14,400 requests/day, extremely fast Llama 3.3 70B)
# Sign up: https://console.groq.com/ → Keys: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# xAI Grok API (free tier available)
# Sign up: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
