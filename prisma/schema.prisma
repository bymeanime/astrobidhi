// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // URL is only used by Prisma CLI for migrations — at runtime, the driver adapter
  // (PrismaLibSQL) handles the actual Turso connection using DATABASE_URL env var
  url = env("DATABASE_URL")
}

model CachedAnalysis {
  id           String   @id @default(cuid())
  cacheKey     String   @unique
  analysisType String
  chartData    String   // Compressed chart data JSON
  result       String   // AI analysis result
  provider     String   // Which AI provider was used
  createdAt    DateTime @default(now())
}

model CachedStaticMeanings {
  id       String   @id @default(cuid())
  cacheKey String   @unique
  result   String   // Static meanings JSON
  createdAt DateTime @default(now())
}

model DeviceUsage {
  id          String   @id @default(cuid())
  deviceId    String   // UUID generated on frontend, stored in localStorage
  analysisType String  // Which analysis was requested
  cacheKey    String   // The cache key of the analysis (to track unique chart readings)
  createdAt   DateTime @default(now())
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // "chart_generation", "analysis_request", "share", "page_view"
  deviceId    String?
  metadata    String   // JSON string with event details
  createdAt   DateTime @default(now())
}

model SharedChart {
  id              String   @id @default(cuid())
  shareId         String   @unique @default(cuid())
  chartParams     String   // JSON: birth details
  analysisType    String?
  includeAnalysis Boolean  @default(false)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
}

model UserAccount {
  id           String   @id @default(cuid())
  whopUserId   String   @unique  // Whop user ID
  name         String?
  email        String?
  picture      String?
  primaryDeviceId String? // Their main device UUID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserAnalysis {
  id           String   @id @default(cuid())
  whopUserId   String   // Links to UserAccount.whopUserId
  analysisType String
  cacheKey     String   // Links to CachedAnalysis.cacheKey
  birthDetails String   // JSON: birth params for display (name, date, location)
  createdAt    DateTime @default(now())
}
